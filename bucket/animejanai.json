{
    "version": "3.2.2",
    "description": "mpv build bundled with AnimeJaNai AI upscaling shaders and enhancements",
    "homepage": "https://github.com/the-database/mpv-upscale-2x_animejanai",
    "license": "GPL-3.0",
    "notes": [
        "Configuration is persisted in portable_config.",
        "AnimeJaNai data is persisted across updates."
    ],
    "architecture": {
        "64bit": {
            "url": [
                "https://github.com/the-database/mpv-upscale-2x_animejanai/releases/download/3.2.2/mpv-upscale-2x_animejanai-full-package-3.2.2.7z.001",
                "https://github.com/the-database/mpv-upscale-2x_animejanai/releases/download/3.2.2/mpv-upscale-2x_animejanai-full-package-3.2.2.7z.002"
            ],
            "hash": [
                "sha256:41e63278f42eadde64b6551dc0daea8c43dfc1343d486d827dd508ea1d204abb",
                "sha256:be243ebd9fed387b393d3122c6e359cb39d8e7cf6a16a1e44ea27d46e8c0dddb"
            ]
        }
    },
    "depends": [
        "7zip"
    ],
    "pre_install": [
        "$archive = Get-ChildItem \"$cachedir\\animejanai*3.2.2*.001\" | Select-Object -First 1",
        "if (-not $archive) { throw \"[AnimeJaNai] Split archive (.7z.001) not found in '$cachedir'. Download may have failed.\" }",
        "Write-Host \"Extracting $($archive.Name)...\"",
        "7z x $archive.FullName -o\"$dir\" -y",
        "if ($LASTEXITCODE -ne 0) { throw \"[AnimeJaNai] 7-Zip extraction failed with exit code $LASTEXITCODE.\" }"
    ],
    "installer": {
        "script": [
            "$folders = @(Get-ChildItem $dir | Where-Object { $_.PSIsContainer })",
            "if ($folders.Count -eq 0) { throw \"[AnimeJaNai] No subfolder found after extraction. Archive structure may have changed.\" }",
            "if ($folders.Count -gt 1) { Write-Warning \"[AnimeJaNai] Multiple subfolders found; using first: $($folders[0].Name)\" }",
            "$folder = $folders[0]",
            "Get-ChildItem $folder.FullName | Move-Item -Destination $dir -Force",
            "Remove-Item $folder.FullName -Recurse -Force"
        ]
    },
    "uninstaller": {
        "script": [
            "Write-Host \"Cleaning up AnimeJaNai temporary files...\"",
            "$tmpFiles = Get-ChildItem \"$cachedir\" -Filter 'animejanai*3.2.2*.7z.*' -ErrorAction SilentlyContinue",
            "if ($tmpFiles) { $tmpFiles | Remove-Item -Force }"
        ]
    },
    "bin": [
        "mpvnet.exe"
    ],
    "shortcuts": [
        [
            "mpvnet.exe",
            "mpv AnimeJaNai"
        ]
    ],
    "persist": [
        "portable_config",
        "animejanai"
    ],
    "checkver": {
        "github": "https://github.com/the-database/mpv-upscale-2x_animejanai"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": [
                    "https://github.com/the-database/mpv-upscale-2x_animejanai/releases/download/$version/mpv-upscale-2x_animejanai-full-package-$version.7z.001",
                    "https://github.com/the-database/mpv-upscale-2x_animejanai/releases/download/$version/mpv-upscale-2x_animejanai-full-package-$version.7z.002"
                ]
            }
        }
    }
}
